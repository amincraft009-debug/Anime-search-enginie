body {
    background-color: #0f172a;
    color: #f8fafc;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 20px;
    display: flex;
    justify-content: center;
}

.container {
    width: 100%;
    max-width: 500px;
    text-align: center;
}

h1 {
    font-size: 1.5rem;
    color: #38bdf8;
    margin-bottom: 10px;
}

p {
    color: #94a3b8;
    font-size: 0.9rem;
    margin-bottom: 20px;
}

.search-box {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

input {
    flex: 1;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #334155;
    background-color: #1e293b;
    color: white;
    font-size: 1rem;
}

button {
    padding: 12px 20px;
    border-radius: 8px;
    border: none;
    background-color: #38bdf8;
    color: #0f172a;
    font-weight: bold;
    cursor: pointer;
}

button:active {
    background-color: #0ea5e9;
}

.results {
    text-align: right;
    margin-top: 20px;
}

.result-card {
    background-color: #1e293b;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 10px;
    border: 1px solid #334155;
}

.result-card a {
    color: #38bdf8;
    text-decoration: none;
    display: block;
    margin-top: 5px;
}
